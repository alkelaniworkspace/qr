# Supabase (own project for this platform, region eu-central-1 / Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose. Used for scan logging and public page lookups.
SUPABASE_SECRET_KEY=sb_secret_...

# Public URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional short domain printed inside dynamic codes, e.g. https://scn.wk
# Point this domain at the same deployment. Decide BEFORE printing the first code.
NEXT_PUBLIC_SHORT_URL=

# Random secret for privacy-preserving unique-visitor hashes (openssl rand -hex 32)
VISITOR_SALT=

# Optional: Google Safe Browsing API key to block phishing/malware targets
GOOGLE_SAFE_BROWSING_KEY=
